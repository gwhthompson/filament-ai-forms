{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "none"
        },
        "not_operator_with_successor_space": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "phpdoc_order": true,
        "phpdoc_separation": true,
        "phpdoc_align": {
            "align": "left"
        }
    }
}
